# TLS for the custom domain via Let's Encrypt (HTTP-01 on :80). Certificates
# persist in the caddy_data volume, so redeploys don't hit ACME rate limits.
# The app's own security headers (CSP, nosniff, referrer, permissions) come
# from the frontend nginx (frontend/security-headers.conf), so local and
# production responses match; Caddy adds only what needs HTTPS.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Uploads are capped at 100 MB in nginx and the backend; stop larger
	# bodies here already.
	request_body {
		max_size 110MB
	}
	# Caddy sets X-Forwarded-For to the address that connected and
	# X-Forwarded-Proto to https, ignoring any a client sent (no
	# trusted_proxies here); nginx trusts these two (real-ip.conf).
	reverse_proxy frontend:8080
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
