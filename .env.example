# ─────────────────────────────────────────────────────────
# CentriMinds – environment variables
# A filled-in .env is gitignored: NEVER commit it.
# ─────────────────────────────────────────────────────────

# ── App (backend/app/config.py; README.md lists them all) ──
# On AWS these live in /opt/centriminds/.env on the instance.
# deploy/aws/remote-deploy.sh creates that file, generates JWT_SECRET once
# and sets APP_ENV, DOMAIN and CORS_ORIGINS on every deploy; add the others
# there by hand. Locally, docker-compose.yml sets the backend's environment.

# development | production. Production refuses to start with a weak or
# default JWT_SECRET and turns the interactive API docs off.
APP_ENV=development

# Generate with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# false closes sign-up (the page then shows an invitation note instead of
# the form). REGISTRATION_EMAILS, comma-separated, limits sign-up to those
# addresses; production requires it whenever sign-up is open. On AWS, set
# both with deploy/aws/deploy.sh (REGISTRATION_EMAILS=... or =none).
ALLOW_REGISTRATION=true
# REGISTRATION_EMAILS=you@example.com,colleague@example.com

# Optional (defaults shown)
# MAX_UPLOAD_MB=100
# AUTH_ATTEMPTS_PER_MINUTE=10
# JWT_EXPIRE_DAYS=7
# JWT_ALGORITHM=HS256

# ── Deploy tooling (never read by the app) ─────────────────
# The scripts in deploy/ read these from the shell; load a filled-in copy
# with:  set -a; . ./.env; set +a
# deploy/aws/env.sh lists them all. Unset, they default to protominds' own
# deployment (the commented values, and DOMAIN=centriminds.de), so set at
# least DOMAIN for yours.
# Apex domain the app is served on (www.<domain> redirects to it)
DOMAIN=example.com
# AWS CLI profile for deploy/aws/*.sh (empty: the CLI's default credentials)
# AWS_PROFILE=centriminds
# AWS_REGION=eu-central-1
# CloudFormation stack name, also the prefix of its bucket names
# STACK=centriminds
# Optional: email for backup alerts (provision.sh passes it to the stack)
ALERT_EMAIL=
# Optional, only for deploy/hostinger/set-dns.sh when the domain's DNS is at
# Hostinger (elsewhere, set the A records by hand):
# https://hpanel.hostinger.com/profile/api
HOSTINGER_API_TOKEN=
